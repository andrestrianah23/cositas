# Postgres connection string. On Railway this is provided by the Postgres service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lockedin
# Set to true when your database requires SSL (e.g. connecting to Railway's public proxy URL).
DATABASE_SSL=false
# The first administrator. Created on startup if no user with this email exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin
# Set to true to create demo users with a sample routine (local development only).
SEED_DEMO=false
PORT=3000
